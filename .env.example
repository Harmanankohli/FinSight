# FinSight Environment Configuration
# Copy to .env and edit as needed. Defaults work for LM Studio.

# Environment (development | production)
ENV=development

# LLM (LM Studio / OpenAI-compatible local)
LLM_MODEL=qwen/qwen3-30b-a3b-2507
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lmstudio  # LM Studio dummy value; replace with real key for OpenAI/Anthropic
ADK_MODEL=openai/qwen/qwen3-30b-a3b-2507
# Optional: separate model endpoints for summary synthesis and RAGAS eval calls
# LLM_SUMMARY_MODEL=qwen/qwen3-30b-a3b-2507
# LLM_EVAL_MODEL=qwen/qwen3-30b-a3b-2507
LLM_MAX_CONCURRENT=2

# Embedding / Reranker Models (local)
EMBED_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Set to 0 to allow HuggingFace Hub update checks (needed when downloading a model for the first time)
HF_HUB_OFFLINE=1

# Host / Ports
HOST=localhost
ORCHESTRATOR_PORT=8001
AGENT_PORT_RAG=8002
AGENT_PORT_QUANT=8003
AGENT_PORT_MARKET=8004

# MCP and A2A Timeouts
MCP_TIMEOUT=30.0
MCP_MAX_RETRIES=3
A2A_TIMEOUT=300.0
A2A_TIMEOUT_RAG=600.0
A2A_TIMEOUT_QUANT=600.0
A2A_TIMEOUT_MARKET_CONTEXT=600.0

# MCP Server
MCP_SERVER_URL=http://localhost:8010/sse
MCP_SERVER_PORT=8010
MCP_HOST=0.0.0.0
MCP_PORT=8010

# Auth (enable for multi-user production deployments)
# Generate secrets with: openssl rand -hex 32
AUTH_ENABLED=false
# AUTH_JWT_SECRETS=replace-with-32-char-hex-secret
# SERVICE_AUTH_TOKEN=replace-with-16-char-min-service-token
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=1209600
LOGIN_MAX_ATTEMPTS=5
# Comma-separated IPs of trusted reverse proxies (Next.js / ingress container).
# X-Forwarded-For is only read when the direct peer matches this list.
# Leave blank for local dev; in Docker Compose set to Next.js container IP.
# TRUSTED_PROXIES=172.20.0.2

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sandbox (ast | container | disabled)
SANDBOX_MODE=ast

# Feature Flags
EVAL_TRACE_ENABLED=false
SEMANTIC_CACHE_ENABLED=false
# Runtime eval kill switch — bypass RAGAS scoring without restart
EVAL_RUNTIME_DISABLED=false
# Per-minute eval burst limit per process; 0 = unlimited
EVAL_BURST_LIMIT=30
# Per-metric deadline (seconds) so a stuck ragas call can't pin the eval pool
EVAL_METRIC_TIMEOUT=90.0
# Optional: Redis-backed MCP cache for cross-worker sharing (leave blank for in-process)
# REDIS_URL=redis://localhost:6379/0

# Agent Discovery
AGENT_SEED_URLS=http://localhost:8002,http://localhost:8003,http://localhost:8004
AGENT_REGISTRY_URL=http://localhost:8010

# Storage
CHROMA_DIR=./chroma_db
FINSIGHT_DB_PATH=./db/finsight_memory.db

# Langfuse Observability (cloud — get keys at https://cloud.langfuse.com)
# Regions: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US), https://jp.cloud.langfuse.com (Japan)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Logging
# Global default level; per-service keys override it (LOG_LEVEL_<UPPERCASE_SERVICE_NAME>)
LOG_LEVEL=INFO
# Memory retention — records older than this many days are pruned on orchestrator startup
MEMORY_RETENTION_DAYS=90
# LOG_LEVEL_ORCHESTRATOR=DEBUG
# LOG_LEVEL_MCP=DEBUG
# LOG_LEVEL_QUANT=WARNING

# Reports
REPORT_PLACEHOLDER_POLICY=label
REPORTS_OFFLINE=false

# SEC EDGAR (optional - uses public API if not set)
SEC_API_BASE=https://www.sec.gov
# Required: SEC enforces real contact info in User-Agent headers
SEC_USER_AGENT=FinSight Research (your-email@example.com)
