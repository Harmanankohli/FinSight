# LLM
GROQ_API_KEY=gsk_your_groq_api_key_here

# Reddit API (for sentiment agent)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# SEC EDGAR (optional - uses public API if not set)
SEC_EDGAR_API_KEY=

# Google APIs (for ADK orchestrator MCP tools)
GOOGLE_API_KEY=
GOOGLE_DRIVE_OAUTH_TOKEN=

# Redis
REDIS_URL=redis://redis:6379

# Agent URLs (Docker Compose internal DNS)
AGENT_LLAMAINDEX_URL=http://agent-llamaindex:8002
AGENT_LANGGRAPH_URL=http://agent-langgraph:8003
AGENT_CREWAI_URL=http://agent-crewai:8004

# Embedding model (local)
EMBED_MODEL=all-MiniLM-L6-v2
GROQ_MODEL=mixtral-8x7b-32768
CHROMA_DIR=./chroma_db
